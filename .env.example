# Copy this file to `.env` next to compose.yaml to override defaults.
# Defaults are fine for a local single-user lab.

# Web interface bind address. Keep 127.0.0.1 for a local-only deployment.
VULNWATCH_BIND=127.0.0.1
# Host port of the web interface
VULNWATCH_PORT=8080

# PostgreSQL connection used inside the compose network
# (db is not published; do not expose it)
# DATABASE_URL is set in compose.yaml; override there if needed.

# Collector schedule
SYNC_INTERVAL_SECONDS=3600

# Outbound HTTP behavior of the collector
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=5

# Upstream feeds
CVE_NOW_BASE_URL=https://cve.now
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# FIRST EPSS (https://www.first.org/epss/data): official daily bulk CSV is
# synced at most once per score date; the single-CVE API is used for
# on-demand lookups only, never for bulk sync.
EPSS_BULK_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
EPSS_API_URL=https://api.first.org/data/v1/epss

# VulnWatch priority thresholds (0-1). This is a VulnWatch assessment, not an
# official FIRST/CISA/CVSS rating; see README "VulnWatch priority (assessment)".
# EPSS is the probability of exploitation in the wild within 30 days, so 0.5
# means "better than even odds". Elevated is the floor for "medium" when
# combined with High/Critical impact.
PRIORITY_EPSS_HIGH=0.5
PRIORITY_EPSS_ELEVATED=0.1

# cve.now rate limiting: pages pulled per cycle (30 entries/page) and pacing
CVE_NOW_MAX_PAGES_PER_RUN=4
CVE_NOW_PAGE_PAUSE_SECONDS=3
CVE_NOW_DETAIL_PAUSE_SECONDS=3
CVE_NOW_MAX_DETAILS_PER_RUN=25

# --- Extended intelligence sources -----------------------------------------
# Canonical-creating catalogs: NVD, GitHub Advisory, Red Hat, Ubuntu.
# Enrichment-only (attach evidence to already-known CVEs): OSV.dev,
# Exploit-DB, Metasploit, Nuclei, PoC-in-GitHub, Debian tracker,
# CISA advisories. Key-gated (skipped until a key is set): ThreatFox, Vulners.

# NVD REST API 2.0 (attributed CVSS). Free key from
# https://nvd.nist.gov/developers/request-an-api-key raises the rate limit
# from 5 to 50 requests per 30 s.
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
NVD_MAX_PAGES_PER_RUN=3
NVD_PAGE_PAUSE_SECONDS=7

# GitHub Advisory Database (public REST; token optional, raises the rate limit)
GH_ADV_URL=https://api.github.com/advisories
GITHUB_TOKEN=
GH_ADV_MAX_PAGES_PER_RUN=4

# OSV.dev detail enrichment for the GHSA ids found by the GitHub Advisory source
OSV_API_URL=https://api.osv.dev/v1/vulns
OSV_MAX_PER_RUN=30

# Public exploit/PoC evidence feeds (enrichment-only)
EXPLOIT_DB_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv
METASPLOIT_URL=https://raw.githubusercontent.com/rapid7/metasploit-framework/master/db/modules_metadata_base.json
NUCLEI_TREE_URL=https://api.github.com/repos/projectdiscovery/nuclei-templates/git/trees/main?recursive=1
POC_BASE_URL=https://raw.githubusercontent.com/nomi-sec/PoC-in-GitHub/master
POC_MAX_PER_RUN=15

# Vendor/distro remediation feeds
REDHAT_SECURITYDATA_URL=https://access.redhat.com/hydra/rest/securitydata/cve.json
REDHAT_MAX_PAGES_PER_RUN=5
DEBIAN_TRACKER_URL=https://security-tracker.debian.org/tracker/data/json
UBUNTU_API_URL=https://cve.ubuntu.com/api/v0/cves/
UBUNTU_MAX_PAGES_PER_RUN=5

# Context feeds. cisa.gov is Akamai-blocked for some datacenter IPs; point
# CISA_ADVISORIES_URL at a reachable mirror if needed.
CISA_ADVISORIES_URL=https://www.cisa.gov/cybersecurity-advisories/all.xml

# ThreatFox (abuse.ch): free Auth-Key from https://auth.abuse.ch/ required
THREATFOX_API_URL=https://threatfox-api.abuse.ch/api/v1/
THREATFOX_AUTH_KEY=

# Vulners: API key required (https://vulners.com/user/register); the
# unauthenticated endpoint is Cloudflare-challenged for datacenter IPs
VULNERS_API_URL=https://vulners.com/api/v3/search/id/
VULNERS_API_KEY=
VULNERS_MAX_PER_RUN=20

# Allow the dashboard to trigger a manual sync (POST /api/sync/run)
ALLOW_MANUAL_SYNC=true
