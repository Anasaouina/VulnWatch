# Copy this file to `.env` next to compose.yaml to override defaults.
# Defaults are fine for a local single-user lab.

# Web interface bind address. Keep 127.0.0.1 for a local-only deployment.
VULNWATCH_BIND=127.0.0.1
# Host port of the web interface
VULNWATCH_PORT=8080

# PostgreSQL connection used inside the compose network
# (db is not published; do not expose it)
# DATABASE_URL is set in compose.yaml; override there if needed.

# Collector schedule
SYNC_INTERVAL_SECONDS=3600

# Outbound HTTP behavior of the collector
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=5

# Upstream feeds
CVE_NOW_BASE_URL=https://cve.now
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# cve.now rate limiting: pages pulled per cycle (30 entries/page) and pacing
CVE_NOW_MAX_PAGES_PER_RUN=4
CVE_NOW_PAGE_PAUSE_SECONDS=3
CVE_NOW_DETAIL_PAUSE_SECONDS=3
CVE_NOW_MAX_DETAILS_PER_RUN=25

# Allow the dashboard to trigger a manual sync (POST /api/sync/run)
ALLOW_MANUAL_SYNC=true
